{
  "name": "flashstone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "deploy": "vite build && wrangler pages deploy",
    "cards": "node scripts/build-sl-cards.mjs",
    "realtime": "wrangler dev --config workers/realtime/wrangler.toml --port 8787 --persist-to .wrangler/state",
    "deploy:realtime": "wrangler deploy --config workers/realtime/wrangler.toml"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "svelte": "^4.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
